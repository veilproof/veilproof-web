# Copy to .env.local and adjust. All values are PUBLIC config — no secrets.

# veilproof-server base URL. The hosted instance backs the deployed dashboard.
# It runs on a free tier that sleeps when idle, so the first request after a
# quiet spell can take up to a minute. Point this at http://localhost:8080 when
# running the server yourself.
VEILPROOF_API_URL=https://veilproof-server.onrender.com

# Deployed veilproof-registry contract id (C...).
VEILPROOF_REGISTRY_CONTRACT_ID=CC4IXULTDJ5OPE2YOBNIROD2HME2VA7QNK2NDCIUQQ453PZGFZVDMJFR

# Soroban RPC endpoint, for reading contract state directly (independent of the API).
VEILPROOF_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase the contract is deployed on.
VEILPROOF_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
