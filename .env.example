# Copy to .env.local to override .env.production in development. All values are
# PUBLIC config: there are no secrets, and the app has no backend.

# Deployed veilproof-registry contract id (C...).
VEILPROOF_REGISTRY_CONTRACT_ID=CDTKXCMHMNRIOBO5IFMZIYT3FI4U72T2IYSBMA7S3W4AGPVIA5I4GQRH

# Soroban RPC endpoint, for reading contract state and submitting transactions.
VEILPROOF_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase the contract is deployed on.
VEILPROOF_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Digest of the verifying key the registry's circuit was registered with. The
# prover refuses any other keys. Keep in step with prover.lock.json.
VEILPROOF_VK_SHA256=85d36192c03cb9240eeb03cb6a7c8dd954fac43ca31955e01fadd2b58f827218

# The circuit a self-service credential is bound to.
VEILPROOF_CIRCUIT=membership
